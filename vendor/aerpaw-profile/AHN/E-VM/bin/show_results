#!/bin/bash

RESULTS_DIR="/root/Results"
DEFAULT_LINES=200

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
RED='\033[1;31m'
RESET='\033[0m'

error() {
    echo -e "${RED}[$(basename "$0")] $1${RESET}" >&2
}

require_less() {
    if command -v less >/dev/null 2>&1; then
        return 0
    fi

    error "The pager 'less' is required for q-to-quit viewing."
    error "Install 'less' or run tail manually on the desired log."
    exit 1
}

collect_latest_results() {
    if [ ! -d "$RESULTS_DIR" ]; then
        error "Results directory not found at $RESULTS_DIR."
        exit 1
    fi

    declare -A grouped_paths=()
    declare -a prefixes=()

    while IFS= read -r -d '' path; do
        [ -f "$path" ] || continue
        base=$(basename "$path")
        prefix=""
        if [[ "$base" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}_[0-9]{2}_[0-9]{2}) ]]; then
            prefix="${BASH_REMATCH[1]}"
        else
            if mtime=$(stat -c %Y "$path" 2>/dev/null); then
                prefix="mtime_${mtime}"
            else
                prefix="mtime_unknown"
            fi
        fi

        if [ -z "${grouped_paths[$prefix]+x}" ]; then
            prefixes+=("$prefix")
            grouped_paths["$prefix"]="$path"$'\n'
        else
            grouped_paths["$prefix"]+="$path"$'\n'
        fi
    done < <(find "$RESULTS_DIR" -maxdepth 1 -type f -print0)

    if [ "${#prefixes[@]}" -eq 0 ]; then
        error "No result files available in $RESULTS_DIR."
        exit 1
    fi

    mapfile -t sorted_prefixes < <(printf '%s\n' "${prefixes[@]}" | sort -r)

    latest_key=""
    latest_files=()

    for candidate_key in "${sorted_prefixes[@]}"; do
        candidate_files=()
        while IFS= read -r line; do
            [ -n "$line" ] && candidate_files+=("$line")
        done <<< "${grouped_paths[$candidate_key]}"

        if [ "${#candidate_files[@]}" -eq 0 ]; then
            continue
        fi

        all_schedule=true
        for f in "${candidate_files[@]}"; do
            if [ "$(basename "$f")" != "experiment_schedule.log" ]; then
                all_schedule=false
                break
            fi
        done

        if [ "$all_schedule" = true ]; then
            # Skip schedule-only logs so we show the most recent experiment output instead.
            continue
        fi

        latest_key="$candidate_key"
        latest_files=("${candidate_files[@]}")
        break
    done

    if [ -z "$latest_key" ] || [ "${#latest_files[@]}" -eq 0 ]; then
        error "No usable result files found (only experiment_schedule.log entries exist)."
        exit 1
    fi

    if [[ "$latest_key" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})_([0-9]{2})_([0-9]{2})_([0-9]{2})$ ]]; then
        latest_timestamp_readable="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}:${BASH_REMATCH[3]}:${BASH_REMATCH[4]}"
    elif [[ "$latest_key" == mtime_* ]]; then
        epoch_value=${latest_key#mtime_}
        latest_timestamp_readable=$(date -d "@$epoch_value" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
        if [ -z "$latest_timestamp_readable" ]; then
            latest_timestamp_readable="epoch $epoch_value"
        fi
    else
        latest_timestamp_readable="$latest_key"
    fi
}

show_menu() {
    echo ""
    echo -e "${CYAN}Latest result set${RESET} (${MAGENTA}${latest_timestamp_readable}${RESET}) from ${YELLOW}${RESULTS_DIR}${RESET}:"
    for idx in "${!latest_files[@]}"; do
        file="${latest_files[$idx]}"
        base=$(basename "$file")
        size=$(du -h "$file" 2>/dev/null | awk '{print $1}')
        printf "  ${YELLOW}[%d]${RESET} %s%s\n" "$((idx + 1))" "$base" "${size:+ (${size})}"
    done
    echo -e "  ${YELLOW}[q]${RESET} Quit"
}

view_log() {
    local file="$1"
    if [ ! -f "$file" ]; then
        error "File $file no longer exists."
        return
    fi

    clear
    echo -e "${GREEN}Viewing last ${DEFAULT_LINES} lines of ${MAGENTA}$(basename "$file")${RESET}."
    echo -e "${CYAN}Press 'q' to exit the viewer.${RESET}"
    echo ""

    tail -n "$DEFAULT_LINES" "$file" | less -R +G
}

main() {
    require_less
    collect_latest_results

    while true; do
        show_menu
        read -r -p "$(echo -e "${GREEN}Select a log to view (number or q): ${RESET}")" choice

        case "$choice" in
            q|Q)
                echo -e "${YELLOW}Exiting.${RESET}"
                exit 0
                ;;
        esac

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#latest_files[@]}" ]; then
            selected="${latest_files[$((choice - 1))]}"
            view_log "$selected"
        else
            echo -e "${RED}Invalid selection.${RESET}"
        fi
    done
}

main "$@"
