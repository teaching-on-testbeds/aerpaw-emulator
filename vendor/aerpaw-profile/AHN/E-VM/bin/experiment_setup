    def run_radio_menu(self):
        while True:
            self.refresh_screen()
            print(Colors.cyan("Select a radio experiment to configure:"))

            for i, exp in enumerate(self.RADIO_EXPERIMENTS, 1):
                print(Colors.yellow(f"{i:2}) {exp[0]}"))
            print(Colors.yellow(" 0) Back to Main Menu"))

            max_choice = len(self.RADIO_EXPERIMENTS)
            choice = self.get_choice(
                f"Enter your choice [0-{max_choice}]: ", range(0, max_choice + 1)
            )

            if choice == 0:
                break

            exp = self.RADIO_EXPERIMENTS[choice - 1]
            exp_name = exp[0]

            if len(exp) == 3:
                self.exp_manager.setup_experiment(
                    exp[2],
                    exp_name,
                    self.config.radio_samples_dir,
                    self.config.radio_target_dir,
                    "startRadio.sh",
                )
            else:
                # Has sub-options
                print(Colors.cyan(f"Select component to set up for {exp_name}:"))
                for i, (opt_name, _) in enumerate(exp[1], 1):
                    print(Colors.yellow(f"{i}) {opt_name}"))

                sub_choice = self.get_choice(
                    f"Enter your choice [1-{len(exp[1])}]: ", range(1, len(exp[1]) + 1)
                )
                opt_name, script = exp[1][sub_choice - 1]
                self.exp_manager.setup_experiment(
                    script,
                    f"{exp_name} ({opt_name})",
                    self.config.radio_samples_dir,
                    self.config.radio_target_dir,
                    "startRadio.sh",
                )

