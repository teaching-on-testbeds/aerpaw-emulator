    def run_profile_menu(self):
        while True:
            self.refresh_screen()
            print(Colors.cyan("Experiment Profile Management:"))
            print(Colors.yellow("1) Save Current Configuration as Profile"))
            print(Colors.yellow("2) List Saved Profiles"))
            print(Colors.yellow("3) Restore Profile"))
            print(Colors.yellow("4) Delete Profile"))
            print(Colors.yellow("5) Export Profile to File"))
            print(Colors.yellow("6) Import Profile from File"))
            print(Colors.yellow("7) Reset to Fresh State"))
            print(Colors.yellow("8) Show Current Changes"))
            print(Colors.yellow("0) Back to Main Menu"))

            choice = self.get_choice("Enter your choice [0-8]: ", range(0, 9))

            if choice == 0:
                break
            elif choice == 1:
                self._save_profile()
            elif choice == 2:
                self._list_profiles()
            elif choice == 3:
                self._restore_profile()
            elif choice == 4:
                self._delete_profile()
            elif choice == 5:
                self._export_profile()
            elif choice == 6:
                self._import_profile()
            elif choice == 7:
                self._reset_fresh()
            elif choice == 8:
                self._show_changes()

    def _save_profile(self):
        print(Colors.cyan("Save Current Experiment Profile"))
        name = input("Enter a name for this profile: ").strip()
        if name:
            self.profile_manager.save_profile(name)
        else:
            print(Colors.red("Profile name cannot be empty."))

    def _list_profiles(self):
        print(Colors.cyan("Saved Experiment Profiles:"))
        print()

        profiles = self.profile_manager.list_profiles()
        if not profiles:
            print(Colors.yellow("No saved profiles found."))
        else:
            for i, name in enumerate(profiles, 1):
                meta = self.profile_manager.get_profile_metadata(name)
                print(Colors.yellow(f"{i}) {name}"))
                print(f"   Created: {meta.get('created_at', 'unknown')}")
                print(
                    f"   Method: {meta.get('method', 'unknown')} | Node: {meta.get('node_type', 'unknown')}"
                )
        print()
        self.pause()

    def _restore_profile(self):
        print(Colors.cyan("Restore Experiment Profile"))
        print()

        profiles = self.profile_manager.list_profiles()
        if not profiles:
            print(Colors.yellow("No saved profiles found."))
            return

        idx = self.select_from_list(
            profiles, f"Select profile to restore [0-{len(profiles)}]: "
        )
        if idx is None:
            return

        print(
            Colors.yellow("This will overwrite your current experiment configuration.")
        )
        confirm = input("Continue? (y/n): ").strip().lower()
        if confirm == "y":
            self.profile_manager.restore_profile(profiles[idx])

    def _delete_profile(self):
        print(Colors.cyan("Delete Experiment Profile"))
        print()

        profiles = self.profile_manager.list_profiles()
        if not profiles:
            print(Colors.yellow("No saved profiles found."))
            return

        idx = self.select_from_list(
            profiles, f"Select profile to delete [0-{len(profiles)}]: "
        )
        if idx is None:
            return

        print(
            Colors.red(
                f"WARNING: This will permanently delete profile '{profiles[idx]}'."
            )
        )
        confirm = input("Are you sure? (y/n): ").strip().lower()
        if confirm == "y":
            self.profile_manager.delete_profile(profiles[idx])

    def _export_profile(self):
        print(Colors.cyan("Export Experiment Profile"))
        print()

        profiles = self.profile_manager.list_profiles()
        if not profiles:
            print(Colors.yellow("No saved profiles found. Save a profile first."))
            return

        idx = self.select_from_list(
            profiles, f"Select profile to export [0-{len(profiles)}]: "
        )
        if idx is None:
            return

        self.profile_manager.export_profile(profiles[idx])

    def _import_profile(self):
        print(Colors.cyan("Import Experiment Profile"))
        print()
        print(Colors.cyan("Import options:"))
        print(Colors.yellow("1) Import from exports directory"))
        print(Colors.yellow("2) Import from custom path"))
        print(Colors.yellow("0) Cancel"))

        choice = self.get_choice("Select option [0-2]: ", range(0, 3))

        if choice == 0:
            return

        if choice == 1:
            exports = self.profile_manager.list_exports()
            if not exports:
                print(
                    Colors.yellow(f"No export files found in {self.config.exports_dir}")
                )
                return

            export_names = [f.name for f in exports]
            idx = self.select_from_list(
                export_names, f"Select file to import [0-{len(exports)}]: "
            )
            if idx is None:
                return

            self.profile_manager.import_profile(exports[idx])
        else:
            path = input("Enter the full path to the .tar.gz file: ").strip()
            if path:
                self.profile_manager.import_profile(Path(path))
            else:
                print(Colors.red("Path cannot be empty."))

    def _reset_fresh(self):
        print(Colors.red("Reset Experiment to Fresh State"))
        print()
        print(Colors.yellow("This will:"))
        print("  - Reset all tracked directories to git HEAD state")
        print("  - Remove any untracked files in experiment directories")
        print("  - Disable all scripts in startexperiment.sh")
        print()
        print(
            Colors.red(
                "WARNING: This cannot be undone unless you have saved a profile!"
            )
        )

        confirm = input("Are you sure you want to reset? (y/n): ").strip().lower()
        if confirm == "y":
            self.profile_manager.reset_to_fresh_state()

    def _show_changes(self):
        print()
        self.profile_manager.show_current_changes()
        print()
        self.pause()

    def run(self):
        while True:
            self.refresh_screen()
            print(Colors.cyan("Select the type of experiment to configure:"))
            print(Colors.yellow("1) Radio Experiments"))
            print(Colors.yellow("2) Vehicle Experiments"))
            print(Colors.yellow("3) Traffic Generation Experiments"))
            print(Colors.yellow("4) Manage Experiment Profiles"))
            print(Colors.yellow("0) Exit"))

            choice = self.get_choice("Enter your choice [0-4]: ", range(0, 5))

            if choice == 0:
                print("Exiting experiment setup. Your settings have been saved.")
                break
            elif choice == 1:
                self.run_radio_menu()
            elif choice == 2:
                self.run_vehicle_menu()
            elif choice == 3:
                self.run_traffic_menu()
            elif choice == 4:
                self.run_profile_menu()

def main():
    config = Config()
    menu = Menu(config)

    try:
        menu.run()
    except KeyboardInterrupt:
        print("\n\nExiting...")
        sys.exit(0)


if __name__ == "__main__":
    main()
